{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/app",
      "destination": "/app/index.html"
    },
    {
      "source": "/mapa",
      "destination": "/mapa/index.html"
    },
    {
      "source": "/livro",
      "destination": "/livro/index.html"
    },
    {
      "source": "/obrigado",
      "destination": "/obrigado/index.html"
    },
    {
      "source": "/checkin",
      "destination": "/checkin/index.html"
    },
    {
      "source": "/valores",
      "destination": "/valores/index.html"
    },
    {
      "source": "/pacientes",
      "destination": "/pacientes/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/ebook",
      "destination": "/livro/",
      "permanent": true
    },
    {
      "source": "/ebook/(.*)",
      "destination": "/livro/",
      "permanent": true
    },
    {
      "source": "/guia",
      "destination": "/guia-ibct.pdf",
      "permanent": false
    },
    {
      "source": "/guia-act",
      "destination": "/guia-act.pdf",
      "permanent": false
    },
    {
      "source": "/guide",
      "destination": "/guide-ibct.pdf",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/guia-ibct.pdf",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Content-Disposition",
          "value": "inline; filename=\"Guia-IBCT-casais.pdf\""
        }
      ]
    },
    {
      "source": "/guia-act.pdf",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Content-Disposition",
          "value": "inline; filename=\"Guia-ACT-terapia-individual.pdf\""
        }
      ]
    },
    {
      "source": "/guide-ibct.pdf",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        },
        {
          "key": "Content-Disposition",
          "value": "inline; filename=\"Guide-IBCT-couples.pdf\""
        }
      ]
    },
    {
      "source": "/checkin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/valores/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/pacientes/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}

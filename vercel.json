{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/mapa",
      "destination": "/mapa/index.html"
    },
    {
      "source": "/livro",
      "destination": "/livro/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/ebook",
      "destination": "/livro/",
      "permanent": true
    },
    {
      "source": "/ebook/(.*)",
      "destination": "/livro/",
      "permanent": true
    }
  ]
}
